*.py[cod]
.pytest_cache/
.venv/
.env
.env.*
*.pem
*.key
credentials.json
secrets/
.DS_Store

# Data that must not be published: raw clouds, weights, archives, local dumps
*.pcd
*.bin
*.ply
*.pth
*.pt
*.onnx
*.tar
*.tar.gz
*.zip
*.mp4
input/
data/*
output/
provided-results/
student-prelabel-*/
student-bundles/

# Loose run artifacts outside the group submission
*.csv
*.json
*.png
*.jpg
*.jpeg
run-*/
qc-cases/

# Licensed KITTI demo stays in the repo
!data/demo.pcd
!data/provenance.json
!data/ATTRIBUTION.md
!data/LICENSE.txt

# Group submission used for grading: report, roster, and A/B/C evidence
!K4-DAY13-NhomChiBang/
!K4-DAY13-NhomChiBang/run-*/
!K4-DAY13-NhomChiBang/qc-cases/
!K4-DAY13-NhomChiBang/**

# Disallowed types stay ignored even inside the submission folder
K4-DAY13-NhomChiBang/**/*.pcd
